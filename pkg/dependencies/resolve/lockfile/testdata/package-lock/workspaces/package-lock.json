{
  "name": "monorepo",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "monorepo",
      "workspaces": [
        "packages/*"
      ],
      "devDependencies": {
        "lint": "^1.0.0"
      }
    },
    "node_modules/@acme/lib": {
      "resolved": "packages/lib",
      "link": true
    },
    "node_modules/aliased": {
      "name": "real-name",
      "version": "4.0.0"
    },
    "node_modules/app": {
      "resolved": "packages/app",
      "link": true
    },
    "node_modules/lint": {
      "version": "1.0.0",
      "dev": true
    },
    "node_modules/ms": {
      "version": "2.1.3"
    },
    "node_modules/orphan": {
      "version": "0.0.1",
      "extraneous": true,
      "dependencies": {
        "ms": "^2.0.0"
      }
    },
    "node_modules/tiny": {
      "version": "1.0.0"
    },
    "node_modules/util": {
      "resolved": "packages/util",
      "link": true
    },
    "packages/app": {
      "version": "1.0.0",
      "dependencies": {
        "@acme/lib": "*",
        "aliased": "npm:real-name@^4.0.0",
        "ms": "^1.0.0"
      }
    },
    "packages/app/node_modules/ms": {
      "version": "1.0.0"
    },
    "packages/lib": {
      "name": "@acme/lib",
      "version": "1.0.0",
      "dependencies": {
        "ms": "^2.0.0",
        "util": "*"
      }
    },
    "packages/util": {
      "dependencies": {
        "tiny": "^1.0.0"
      }
    }
  }
}
